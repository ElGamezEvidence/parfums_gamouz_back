# ==============================================================================
# GAAMOUZE BACKEND CONFIGURATION
# ==============================================================================

# Database Connection (Neon PostgreSQL with SSL)
# LOCAL : copiez ici votre URL Neon (fichier .env, jamais commité).
# RAILWAY : ne pas mettre DATABASE_URL dans le code — onglet Variables du service backend uniquement.
# Direct host (sans -pooler) recommandé pour migrate deploy en local ; pooler OK pour l'app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&connect_timeout=60"

# Server Port & Environment
PORT=3000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated if multiple)
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
# URL publique du backend (pour les liens /uploads/...) — Railway : https://votre-service.up.railway.app
PUBLIC_API_URL="http://localhost:3000"

# JWT Authentication
JWT_SECRET="replace_with_a_long_random_secret_at_least_32_chars"
JWT_EXPIRES_IN="7d"
COOKIE_DOMAIN=""

# Initial Administrator Provisioning (Idempotent)
ADMIN_EMAIL="abdelaligamouz@1448"
ADMIN_INITIAL_PASSWORD="replace_with_a_secure_initial_password"

# Optional Cloud Storage (Cloudinary / AWS S3)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Optional Transactional Email (Resend / SendGrid / SMTP)
# RESEND_API_KEY=""
# EMAIL_FROM="contact@gamouze.com"
